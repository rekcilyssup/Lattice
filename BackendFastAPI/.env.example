# Copy to .env and fill in. NEVER commit the real .env.
APP_NAME=lattice-api
ENV=dev
PORT=8080
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=lattice
POSTGRES_USER=lattice
POSTGRES_PASSWORD=lattice
POSTGRES_SSL=false

UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=20
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
LLM_TEMPERATURE=0.1

# Only needed if you switch away from local models. Keep keys in .env, never in code.
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=

RERANK_PROVIDER=heuristic
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_K_RERANK=20
